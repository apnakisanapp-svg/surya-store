# Copy this file to ".env" (or set these in your host's dashboard).
NODE_ENV=production
SITE_URL=https://www.yourshop.in        # your website address
PUBLIC_PORT=3000
ADMIN_PORT=4000
ADMIN_HOST=127.0.0.1                    # keep as is: admin is not open to the internet directly
DATA_DIR=./data                         # database + photos live here. BACK THIS UP / use a persistent disk
APP_SECRET=change-me-to-a-long-random-text
SECURE_COOKIES=1                        # 1 when your site runs on https
ADMIN_EMAIL=you@example.com             # first login email (password is printed once on first start)
ADMIN_IP_ALLOW=                         # optional: your home/shop IP, e.g. 103.21.4.5 (only this IP can open admin)
SMTP_URL=                               # optional: smtp://user:pass@smtp.gmail.com:587  (for emails)
MAIL_FROM=SURYA <orders@yourshop.in>

# --- Free hosting (see FREE-HOSTING.md) ---
# SYNC_REPO=yourgithubname/surya-data     # private GitHub repository that keeps your data
# SYNC_TOKEN=github_pat_xxx               # token with Contents: read and write for that repository only
# SYNC_MODE=push                          # push = this server is the master (takes orders). pull = read-only copy
# ADMIN_PATH=manage-pick-your-own-secret  # opens the admin at https://yoursite/manage-pick-your-own-secret/ (8+ letters, numbers, dashes)
# CATALOGUE_ONLY=1                        # only for preview copies: blocks checkout

# --- Free phone alerts for new orders / payments (optional, Telegram) ---
# 1) In Telegram search @BotFather → /newbot → copy the token. 2) Send any message to your new bot.
# 3) Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy the number after "chat":{"id":
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Email login code (free): Gmail app password example
# SMTP_URL=smtps://yourname%40gmail.com:APP_PASSWORD@smtp.gmail.com
# MAIL_FROM="Surya Enterprises <yourname@gmail.com>"
